# ── Mock Payment Gateway — local defaults ──
# Copy to .env and adjust. Production platform env vars take precedence.

# Server
PORT=8001
HOST=0.0.0.0

# Database: empty = SQLite file at MOCK_DATA_DIR/mock_payments.db.
# Examples:
#   DATABASE_URL=sqlite:////data/mock_payments.db   (persistent disk)
#   DATABASE_URL=postgresql://user:pass@host:5432/db
DATABASE_URL=
MOCK_DATA_DIR=.

# Latency simulation (milliseconds)
MOCK_MIN_LATENCY_MS=50
MOCK_MAX_LATENCY_MS=300

# Fault injection — all default to "no fault"
MOCK_SYSTEM_ERROR_RATE=0
MOCK_FORCE_SYSTEM_ERROR=false
MOCK_DB_ERROR_RATE=0
MOCK_FORCE_DB_ERROR=false

# Payment outcome simulation
MOCK_PAYMENT_SUCCESS_RATE=90
MOCK_PAYMENT_DECLINE_RATE=8
MOCK_PAYMENT_PENDING_RATE=2
# Deterministic overrides (empty = random)
# MOCK_SEED=42
# MOCK_FORCE_OUTCOME=AUTHORIZED   # AUTHORIZED|DECLINED|PENDING|FAILED
MOCK_SEED=
MOCK_FORCE_OUTCOME=

# Throttling
MOCK_THROTTLE_ENABLED=false
MOCK_THROTTLE_REQUESTS_PER_MINUTE=60

# Observability — Loki is optional; console logging always stays on.
# Set LOKI_ENABLED=false locally if you have no Loki running.
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100/loki/api/v1/push
LOKI_SERVICE_NAME=mock-payment
LOKI_ENVIRONMENT=local
